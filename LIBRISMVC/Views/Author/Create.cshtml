@using LIBRISMVC.ViewModels
@model AuthorViewModel
@{
    ViewData["Title"] = "Add Author";
}

<div class="mt-4 mb-4">
    <h1 class="h3 fw-bold mb-1" style="color: var(--libris-sidebar-bg);">Add New Author</h1>
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i> Back to Directory</a>
</div>

<div class="card table-card col-lg-8 mb-4">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label fw-semibold">Full Name *</label>
                <input asp-for="FullName" class="form-control" required placeholder="e.g. Ursula K. Le Guin" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Nationality" class="form-label fw-semibold">Nationality</label>
                    <input asp-for="Nationality" class="form-control" placeholder="e.g. American" />
                    <span asp-validation-for="Nationality" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="BirthYear" class="form-label fw-semibold">Birth Year</label>
                    <input asp-for="BirthYear" class="form-control" type="number" placeholder="e.g. 1929" />
                    <span asp-validation-for="BirthYear" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked>
                <label class="form-check-label" for="isActiveSwitch">Author is Active</label>
            </div>

            <hr class="mb-4" style="border-color: var(--libris-border);" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save Author</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}