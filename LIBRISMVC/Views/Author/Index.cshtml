@using LIBRISMVC.ViewModels
@model IEnumerable<AuthorViewModel>
@{
    ViewData["Title"] = "Authors Directory";
}

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mt-4 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: var(--libris-sidebar-bg);">Authors</h1>
        <p class="text-muted mb-0">Manage library authors, their nationalities, and active status.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Author
    </a>
</div>

<div class="card table-card mb-4 p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle" id="authorsTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Nationality</th>
                    <th>Birth Year</th>
                    <th>Status</th>
                    <th class="text-end" data-sortable="false">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted">@item.AuthorId</td>
                        <td class="fw-medium">@item.FullName</td>
                        <td>@item.Nationality</td>
                        <td>@item.BirthYear</td>
                        <td>
                            @if (item.IsActive == true)
                            {
                                <span class="status-badge status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.AuthorId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.AuthorId" method="post" onsubmit="return confirm('Are you sure you want to delete this author? This action cannot be undone.');" style="display:inline-block;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <style>
        .dataTable-top {
            padding-bottom: 1rem;
        }

        .dataTable-selector, .dataTable-input {
            border-radius: 0.375rem;
            border: 1px solid var(--libris-border);
            padding: 0.375rem 0.75rem;
            color: var(--libris-text-main);
            outline: none;
        }

            .dataTable-input:focus {
                border-color: var(--libris-accent);
                box-shadow: 0 0 0 0.25rem rgba(168, 208, 182, 0.25);
            }
        
        .dataTable-pagination a {
            color: var(--libris-sidebar-bg);
            border-radius: 0.25rem;
            margin: 0 2px;
        }

            .dataTable-pagination a:hover {
                background-color: rgba(168, 208, 182, 0.3);
            }

        .dataTable-pagination .active a, .dataTable-pagination .active a:hover {
            background-color: var(--libris-sidebar-bg);
            color: #ffffff;
        }
        
        .dataTable-bottom {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 2rem;
            padding-top: 1rem;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const table = new simpleDatatables.DataTable("#authorsTable", {
                searchable: true,
                sortable: true,
                perPage: 10,
                perPageSelect: [5, 10, 15, 20, 50],
                labels: {
                    placeholder: "Search authors...",
                    perPage: "entries",
                    noRows: "No authors found in the database",
                    info: "Showing {start} to {end} of {rows} authors"
                }
            });

            document.addEventListener('input', function (e) {
                if (e.target.classList.contains('dataTable-input')) {
                    if (e.target.value.trim() === '') {
                        table.search('');
                    }
                }
            });

            document.addEventListener('search', function (e) {
                if (e.target.classList.contains('dataTable-input')) {
                    if (e.target.value.trim() === '') {
                        table.search('');
                    }
                }
            });
        });
    </script>
}