@using LIBRISMVC.ViewModels
@model IEnumerable<MemberViewModel>
@{
    ViewData["Title"] = "Members Directory";
}

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mt-4 mb-4">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: var(--libris-sidebar-bg);">Members</h1>
        <p class="text-muted mb-0">Manage library members, their contact info, and status.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Add Member
    </a>
</div>

<div class="card table-card mb-4 p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle libris-datatable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Member Since</th>
                    <th>Status</th>
                    <th class="text-end" data-sortable="false">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-muted">@item.MemberId</td>
                        <td class="fw-medium">@item.FullName</td>
                        <td>@item.Email</td>
                        <td>@item.MemberSince.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="status-badge status-active">Active</span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.MemberId" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.MemberId" method="post" onsubmit="return confirm('Are you sure you want to delete this member? This action cannot be undone.');" style="display:inline-block;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>