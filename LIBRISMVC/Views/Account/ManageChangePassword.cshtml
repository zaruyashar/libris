@using LIBRISMVC.ViewModels
@model ManageChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="mt-4 mb-4">
    <h1 class="h3 fw-bold mb-1" style="color: var(--libris-sidebar-bg);">Change Account Password</h1>
    <span class="text-muted">Manage your credentials and security</span>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success col-lg-8 mb-4" role="alert">
        <i class="fas fa-circle-check me-2"></i>@TempData["SuccessMessage"]
    </div>
}

<div class="card table-card col-lg-8 mb-4">
    <div class="card-body p-4">
        <form asp-action="ManageChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label fw-semibold">Current Password</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" required placeholder="••••••••" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" required placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" required placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <hr class="mb-4" style="border-color: var(--libris-border);" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Password</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
