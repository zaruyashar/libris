@model LIBRISMVC.ViewModels.ChangePasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Reset Password - Libris Admin</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: radial-gradient(circle at top right, #2d4a3e 0%, #111d18 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #ffffff;
            margin: 0;
            padding: 1.5rem;
        }
        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        }
        .brand-logo {
            color: #2ed573;
            font-size: 3rem;
            text-align: center;
            margin-bottom: 0.5rem;
            filter: drop-shadow(0 0 10px rgba(46, 213, 115, 0.4));
        }
        .brand-text {
            text-align: center;
            font-weight: 800;
            letter-spacing: 0.2rem;
            font-size: 1.6rem;
            margin-bottom: 2rem;
            color: #ffffff;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.85);
        }
        .form-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #2ed573;
            box-shadow: 0 0 0 0.25rem rgba(46, 213, 115, 0.25);
            color: #ffffff;
        }
        .btn-primary {
            background-color: #2ed573;
            border-color: #2ed573;
            color: #111d18;
            font-weight: 700;
            padding: 0.75rem;
            border-radius: 0.5rem;
            transition: all 0.2s ease-in-out;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }
        .btn-primary:hover {
            background-color: #26b962;
            border-color: #26b962;
            color: #111d18;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.3);
        }
        .text-link {
            color: #2ed573;
            text-decoration: none;
            font-weight: 600;
        }
        .text-link:hover {
            text-decoration: underline;
            color: #26b962;
        }
        .alert-custom {
            background: rgba(200, 90, 71, 0.2);
            border: 1px solid rgba(200, 90, 71, 0.4);
            color: #ffffff;
            font-size: 0.85rem;
            border-radius: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="brand-logo">
            <i class="fas fa-lock-open"></i>
        </div>
        <div class="brand-text">New Password</div>

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-custom mb-4"></div>

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input class="form-control" type="text" value="@Model.Email" disabled style="opacity: 0.7;" />
            </div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" type="password" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn btn-primary mb-3">Reset Password</button>

            <div class="text-center" style="font-size: 0.85rem;">
                <a asp-action="Login" class="text-link"><i class="fas fa-arrow-left me-1"></i>Back to Sign In</a>
            </div>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
