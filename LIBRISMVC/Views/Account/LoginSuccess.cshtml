@model LIBRISMVC.ViewModels.LoginSuccessViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Logging In... - Libris Admin</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: radial-gradient(circle at top right, #2d4a3e 0%, #111d18 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #ffffff;
            margin: 0;
            padding: 1.5rem;
            text-align: center;
        }
        .success-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            width: 100%;
            max-width: 480px;
            padding: 3rem 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        }
        .success-icon {
            color: #2ed573;
            font-size: 4.5rem;
            margin-bottom: 1.5rem;
            filter: drop-shadow(0 0 15px rgba(46, 213, 115, 0.5));
            animation: pulse 2s infinite;
        }
        .btn-primary {
            background-color: #2ed573;
            border-color: #2ed573;
            color: #111d18;
            font-weight: 700;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            transition: all 0.2s ease-in-out;
            text-decoration: none;
            display: inline-block;
        }
        .btn-primary:hover {
            background-color: #26b962;
            border-color: #26b962;
            color: #111d18;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.3);
        }
        .text-link {
            color: #2ed573;
            text-decoration: none;
            font-weight: 600;
        }
        .text-link:hover {
            text-decoration: underline;
        }
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>

    <div class="success-card">
        <div class="success-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        <h2 class="mb-3" style="font-weight: 700; letter-spacing: 0.5px;">Welcome Back!</h2>
        <p class="mb-4 text-white-50" style="font-size: 0.95rem; line-height: 1.5;">
            You have logged in successfully. The LIBRIS Admin Dashboard is opening in a new browser tab.
        </p>

        <div class="mt-4 mb-4">
            <a href="@Model.RedirectUrl" target="_blank" class="btn btn-primary">
                Open Dashboard Manually
            </a>
        </div>

        <p class="text-white-50" style="font-size: 0.8rem; margin-bottom: 0;">
            If the dashboard doesn't load automatically, your browser might have blocked the popup. Click the button above to launch.
        </p>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var redirectUrl = '@Html.Raw(Model.RedirectUrl)';
            // Attempt to open the dashboard in a new tab/window
            var win = window.open(redirectUrl, '_blank');
            if (win) {
                win.focus();
            }
        });
    </script>
</body>
</html>
