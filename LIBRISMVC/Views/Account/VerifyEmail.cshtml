@model LIBRISMVC.ViewModels.VerifyEmailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Forgot Password - Libris Admin</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            background: radial-gradient(circle at top right, #2d4a3e 0%, #111d18 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #ffffff;
            margin: 0;
            padding: 1.5rem;
        }
        .auth-card {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 1rem;
            width: 100%;
            max-width: 480px;
            padding: 2.5rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        }
        .brand-logo {
            color: #2ed573;
            font-size: 3rem;
            text-align: center;
            margin-bottom: 0.5rem;
            filter: drop-shadow(0 0 10px rgba(46, 213, 115, 0.4));
        }
        .brand-text {
            text-align: center;
            font-weight: 800;
            letter-spacing: 0.2rem;
            font-size: 1.6rem;
            margin-bottom: 2rem;
            color: #ffffff;
        }
        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.85);
        }
        .form-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            border-radius: 0.5rem;
            padding: 0.75rem 1rem;
        }
        .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: #2ed573;
            box-shadow: 0 0 0 0.25rem rgba(46, 213, 115, 0.25);
            color: #ffffff;
        }
        .btn-primary {
            background-color: #2ed573;
            border-color: #2ed573;
            color: #111d18;
            font-weight: 700;
            padding: 0.75rem;
            border-radius: 0.5rem;
            transition: all 0.2s ease-in-out;
            width: 100%;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
        }
        .btn-primary:hover {
            background-color: #26b962;
            border-color: #26b962;
            color: #111d18;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(46, 213, 115, 0.3);
        }
        .text-link {
            color: #2ed573;
            text-decoration: none;
            font-weight: 600;
        }
        .text-link:hover {
            text-decoration: underline;
            color: #26b962;
        }
        .alert-custom {
            background: rgba(200, 90, 71, 0.2);
            border: 1px solid rgba(200, 90, 71, 0.4);
            color: #ffffff;
            font-size: 0.85rem;
            border-radius: 0.5rem;
        }
        .token-box {
            background: rgba(46, 213, 115, 0.1);
            border: 1px solid rgba(46, 213, 115, 0.3);
            border-radius: 0.5rem;
            padding: 1.25rem;
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="brand-logo">
            <i class="fas fa-key"></i>
        </div>
        <div class="brand-text">Reset Password</div>

        @if (Model.RequestSent && !string.IsNullOrEmpty(Model.Token))
        {
            <div class="text-center">
                <div class="alert alert-success bg-opacity-25 border-success text-white mb-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@Model.Message
                </div>
                
                <p class="text-muted-custom" style="font-size: 0.9rem;">
                    Since there is no real email service configured, here is your generated secure reset token:
                </p>

                <div class="token-box">
                    <code class="text-white d-block text-break" style="font-size: 0.95rem; font-family: monospace;">@Model.Token</code>
                </div>

                <a asp-action="ChangePassword" asp-route-email="@Model.Email" asp-route-token="@Model.Token" class="btn btn-primary mb-3">
                    Reset Password Now
                </a>

                <div class="text-center" style="font-size: 0.85rem;">
                    <a asp-action="Login" class="text-link"><i class="fas fa-arrow-left me-1"></i>Back to Sign In</a>
                </div>
            </div>
        }
        else
        {
            <p class="text-center text-muted-custom mb-4" style="font-size: 0.9rem;">
                Enter your email address below, and we will generate a security token to reset your password.
            </p>

            <form asp-action="VerifyEmail" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-custom mb-4"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="admin@libris.com" required autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <button type="submit" class="btn btn-primary mb-3">Generate Reset Token</button>

                <div class="text-center" style="font-size: 0.85rem; color: rgba(255,255,255,0.65);">
                    Remember your password? <a asp-action="Login" class="text-link">Sign in here</a>
                </div>
            </form>
        }
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
