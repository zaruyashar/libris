@using LIBRISMVC.ViewModels
@model GenreViewModel
@{
    ViewData["Title"] = "Edit Genre";
}

<div class="mt-4 mb-4">
    <h1 class="h3 fw-bold mb-1" style="color: var(--libris-sidebar-bg);">Edit Genre</h1>
    <a asp-action="Index" class="text-decoration-none text-muted"><i class="fas fa-arrow-left me-1"></i> Back to Directory</a>
</div>

<div class="card table-card col-lg-8 mb-4">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="GenreId" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Genre Name *</label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3 w-50">
                <label asp-for="CreatedAt" class="form-label fw-semibold">Date Added</label>
                <input asp-for="CreatedAt" class="form-control" type="date" />
                <span asp-validation-for="CreatedAt" class="text-danger small"></span>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                <label class="form-check-label" for="isActiveSwitch">Genre is Active</label>
            </div>

            <hr class="mb-4" style="border-color: var(--libris-border);" />

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Genre</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}